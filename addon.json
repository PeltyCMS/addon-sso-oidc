{
  "id": "sso-oidc",
  "name": "OpenID Connect",
  "version": "0.1.0",
  "kind": "sso",
  "engine": "wasm",
  "provides": "oidc",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.sso.oidc",
  "author": "MythicalSystems",
  "permissions": [
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "$setting:token_url",
      "$setting:userinfo_url"
    ],
    "secrets": []
  },
  "settings": [
    {
      "key": "client_id",
      "label": "addons.sso.setting.client_id",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "client_secret",
      "label": "addons.sso.setting.client_secret",
      "kind": "secret",
      "required": false,
      "default": ""
    },
    {
      "key": "button_label",
      "label": "addons.sso.setting.button_label",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "allow_register",
      "label": "addons.sso.setting.allow_register",
      "kind": "bool",
      "required": false,
      "default": true
    },
    {
      "key": "link_by_verified_email",
      "label": "addons.sso.setting.link_by_verified_email",
      "kind": "bool",
      "required": false,
      "default": false
    },
    {
      "key": "allow_staff",
      "label": "addons.sso.setting.allow_staff",
      "kind": "bool",
      "required": false,
      "default": false
    },
    {
      "key": "authorize_url",
      "label": "addons.sso.setting.authorize_url",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "token_url",
      "label": "addons.sso.setting.token_url",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "userinfo_url",
      "label": "addons.sso.setting.userinfo_url",
      "kind": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "scope",
      "label": "addons.sso.setting.scope",
      "kind": "text",
      "required": false,
      "default": ""
    }
  ]
}
